# Copie para .env.deploy (ignorado pelo git) e ajuste.
# IP do aparelho: Steam > Configurações > Internet (ou `ip -4 addr` no Modo Desktop)
DECK_HOST=192.168.0.50
# Usuário do Bazzite (o criado na instalação; no SteamOS é "deck")
DECK_USER=deck
DECK_PORT=22
# Chave SSH privada (opcional; padrão do ssh se vazio)
DECK_KEY=~/.ssh/id_ed25519
# Senha do sudo (opcional). Se vazio, o sudo pergunta interativamente.
# Atenção: fica em texto puro neste arquivo.
DECK_SUDO_PASS=
