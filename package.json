{
  "name": "steam-system-monitor",
  "version": "0.4.0",
  "description": "Decky Loader plugin: system resource monitor and process manager for Game Mode",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-locales.mjs",
    "test:py": "uv run --no-project --python 3.11 --with pytest python -m pytest -q tests",
    "deploy:ssh": "node scripts/bash.mjs scripts/deploy.sh",
    "deploy:logs": "node scripts/bash.mjs scripts/deploy.sh --logs",
    "package": "node scripts/bash.mjs scripts/deploy.sh --package-only"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
